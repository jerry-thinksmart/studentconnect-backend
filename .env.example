NODE_ENV=development
PORT=3000

# Copy the URI from Supabase: Project Settings > Database > Connection string.
# Use the Session pooler URI for IPv4-only hosts. Never commit the real value.
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DATABASE_SSL=true

# Generate this JSON in Firebase Console > Project settings > Service accounts.
# Keep the JSON file outside source control.
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Protect server-only notification sending endpoints.
NOTIFICATION_API_KEY=replace-with-a-long-random-secret
JWT_SECRET=replace-with-another-long-random-secret

# SQLite chat cache and offline outbox (Node's built-in node:sqlite). Keep it on a persistent disk.
CHAT_CACHE_PATH=./data/chat-cache.db
CHAT_SYNC_INTERVAL_MS=5000
CHAT_DB_TIMEOUT_MS=4000
CHAT_MAX_SYNC_ATTEMPTS=5
